  {
   "type": "timeseries",
   "title": "Temperatura de la masa (banda óptima 45-50 °C)",
   "description": "Lazo 4: > 50 °C o a las 48/96 h -> VOLTEO automático (enfría 3 °C y oxigena).",
   "targets": [
    {
     "refId": "A",
     "query": "from(bucket: \"cacaosmart\")\n  |> range(start: v.timeRangeStart, stop: v.timeRangeStop)\n  |> filter(fn: (r) => r._measurement == \"telemetry\")\n  |> filter(fn: (r) => (r.device == \"dev-07\" and r._field == \"temp_masa_c\") or\n      (r.device == \"dev-07\" and r._field == \"temp_ambiente_c\"))\n  |> aggregateWindow(every: v.windowPeriod, fn: mean, createEmpty: false)\n  |> map(fn: (r) => ({r with _field: r.device + \"/\" + r._field}))\n  |> group()\n  |> pivot(rowKey: [\"_time\"], columnKey: [\"_field\"], valueColumn: \"_value\")"
    }
   ],
