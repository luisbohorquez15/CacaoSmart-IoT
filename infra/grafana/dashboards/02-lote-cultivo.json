  {
   "type": "timeseries",
   "title": "Ruido ambiente (micrófono del iPhone)",
   "description": "",
   "targets": [
    {
     "refId": "A",
     "query": "from(bucket: \"cacaosmart\")\n  |> range(start: v.timeRangeStart, stop: v.timeRangeStop)\n  |> filter(fn: (r) => r._measurement == \"telemetry\")\n  |> filter(fn: (r) => (r.device == \"dev-01\" and r._field == \"ruido_dbfs\"))\n  |> aggregateWindow(every: v.windowPeriod, fn: mean, createEmpty: false)\n  |> map(fn: (r) => ({r with _field: r.device + \"/\" + r._field}))\n  |> group()\n  |> pivot(rowKey: [\"_time\"], columnKey: [\"_field\"], valueColumn: \"_value\")"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "dB",
     "color": {
      "mode": "palette-classic"
     },
     "custom": {
      "lineWidth": 2,
      "fillOpacity": 10,
      "gradientMode": "opacity",
      "spanNulls": 3600000,
      "showPoints": "never",
      "lineInterpolation": "smooth",
      "axisSoftMin": null,
      "thresholdsStyle": {
       "mode": "off"
      },
      "stacking": {
       "mode": "none"
      }
     }
    },
    "overrides": [
     {
      "matcher": {
       "id": "byName",
       "options": "dev-01/ruido_dbfs"
      },
      "properties": [
       {
        "id": "displayName",
        "value": "Ruido (dBFS)"
       },
       {
        "id": "color",
        "value": {
         "mode": "fixed",
         "fixedColor": "#B565D8"
        }
       }
      ]
     }
    ]
   },
   "options": {
    "legend": {
     "displayMode": "table",
     "placement": "bottom",
     "showLegend": true,
     "calcs": [
      "mean",
      "max",
      "min",
      "lastNotNull"
     ]
    },
    "tooltip": {
     "mode": "multi",
     "sort": "none"
