  {
   "type": "timeseries",
   "title": "Temperatura y humedad relativa del dosel",
   "description": "Riesgo de Moniliasis: HR > 88 % y T > 26 °C sostenidos 4 h.",
   "targets": [
    {
     "refId": "A",
     "query": "from(bucket: \"cacaosmart\")\n  |> range(start: v.timeRangeStart, stop: v.timeRangeStop)\n  |> filter(fn: (r) => r._measurement == \"telemetry\")\n  |> filter(fn: (r) => (r.device == \"dev-01\" and r._field == \"temp_c\") or\n      (r.device == \"dev-01\" and r._field == \"hr_pct\"))\n  |> aggregateWindow(every: v.windowPeriod, fn: mean, createEmpty: false)\n  |> map(fn: (r) => ({r with _field: r.device + \"/\" + r._field}))\n  |> group()\n  |> pivot(rowKey: [\"_time\"], columnKey: [\"_field\"], valueColumn: \"_value\")"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "celsius",
     "color": {
      "mode": "palette-classic"
     },
     "custom": {
      "lineWidth": 2,
      "fillOpacity": 10,
      "gradientMode": "opacity",
      "spanNulls": 3600000,
      "showPoints": "never",
      "lineInterpolation": "smooth",
      "axisSoftMin": null,
      "thresholdsStyle": {
       "mode": "line+area"
      },
      "stacking": {
       "mode": "none"
      }
     },
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "transparent",
        "value": null
       },
       {
        "color": "#E5484D22",
        "value": 26
       }
      ]
     }
    },
    "overrides": [
     {
      "matcher": {
       "id": "byName",
       "options": "dev-01/temp_c"
      },
      "properties": [
       {
        "id": "displayName",
        "value": "Temperatura"
       },
       {
        "id": "color",
        "value": {
         "mode": "fixed",
         "fixedColor": "#E8743B"
        }
       }
      ]
     },
     {
      "matcher": {
       "id": "byName",
       "options": "dev-01/hr_pct"
      },
      "properties": [
       {
        "id": "displayName",
        "value": "Humedad relativa"
       },
       {
        "id": "color",
        "value": {
         "mode": "fixed",
         "fixedColor": "#4FA3D1"
        }
       },
       {
        "id": "unit",
        "value": "percent"
       },
       {
        "id": "custom.axisPlacement",
        "value": "right"
       }
      ]
     }
    ]
   },
   "options": {
    "legend": {
     "displayMode": "table",
     "placement": "bottom",
     "showLegend": true,
     "calcs": [
      "mean",
      "max",
      "min",
      "lastNotNull"
     ]
    },
    "tooltip": {
     "mode": "multi",
     "sort": "none"
