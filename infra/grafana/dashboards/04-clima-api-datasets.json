  {
   "type": "timeseries",
   "title": "Temperatura, sensación térmica y punto de rocío",
   "description": "",
   "targets": [
    {
     "refId": "A",
     "query": "from(bucket: \"cacaosmart\")\n  |> range(start: v.timeRangeStart, stop: v.timeRangeStop)\n  |> filter(fn: (r) => r._measurement == \"telemetry\")\n  |> filter(fn: (r) => (r.device == \"dev-03\" and r._field == \"temp_c\") or\n      (r.device == \"dev-03\" and r._field == \"sensacion_c\") or\n      (r.device == \"dev-03\" and r._field == \"punto_rocio_c\"))\n  |> aggregateWindow(every: v.windowPeriod, fn: mean, createEmpty: false)\n  |> map(fn: (r) => ({r with _field: r.device + \"/\" + r._field}))\n  |> group()\n  |> pivot(rowKey: [\"_time\"], columnKey: [\"_field\"], valueColumn: \"_value\")"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "celsius",
     "color": {
      "mode": "palette-classic"
     },
     "custom": {
      "lineWidth": 2,
      "fillOpacity": 10,
      "gradientMode": "opacity",
      "spanNulls": 3600000,
      "showPoints": "never",
      "lineInterpolation": "smooth",
      "axisSoftMin": null,
      "thresholdsStyle": {
       "mode": "off"
      },
      "stacking": {
       "mode": "none"
      }
     }
    },
    "overrides": [
     {
      "matcher": {
       "id": "byName",
       "options": "dev-03/temp_c"
      },
      "properties": [
       {
        "id": "displayName",
        "value": "Temperatura"
       },
       {
        "id": "color",
        "value": {
         "mode": "fixed",
         "fixedColor": "#E8743B"
        }
       }
      ]
     },
     {
      "matcher": {
       "id": "byName",
       "options": "dev-03/sensacion_c"
      },
      "properties": [
       {
        "id": "displayName",
        "value": "Sensación (RealFeel)"
       },
       {
        "id": "color",
        "value": {
         "mode": "fixed",
         "fixedColor": "#E5484D"
        }
       },
       {
        "id": "custom.lineStyle",
        "value": {
         "fill": "dash",
         "dash": [
          10,
          6
         ]
        }
       }
      ]
     },
     {
      "matcher": {
       "id": "byName",
       "options": "dev-03/punto_rocio_c"
