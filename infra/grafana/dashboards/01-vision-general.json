  {
   "type": "timeseries",
   "title": "Clima exterior en vivo vs. mismo día de 2025",
   "description": "Compara el clima actual (API Azure Maps) con el histórico real ERA5 de 2025 a la misma hora.",
   "targets": [
    {
     "refId": "A",
     "query": "from(bucket: \"cacaosmart\")\n  |> range(start: v.timeRangeStart, stop: v.timeRangeStop)\n  |> filter(fn: (r) => r._measurement == \"telemetry\")\n  |> filter(fn: (r) => (r.device == \"dev-03\" and r._field == \"temp_c\") or\n      (r.device == \"dev-09\" and r._field == \"temp_ref_c\") or\n      (r.device == \"dev-03\" and r._field == \"hr_pct\"))\n  |> aggregateWindow(every: v.windowPeriod, fn: mean, createEmpty: false)\n  |> map(fn: (r) => ({r with _field: r.device + \"/\" + r._field}))\n  |> group()\n  |> pivot(rowKey: [\"_time\"], columnKey: [\"_field\"], valueColumn: \"_value\")"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "celsius",
     "color": {
      "mode": "palette-classic"
     },
     "custom": {
      "lineWidth": 2,
      "fillOpacity": 10,
      "gradientMode": "opacity",
      "spanNulls": 3600000,
      "showPoints": "never",
      "lineInterpolation": "smooth",
      "axisSoftMin": null,
      "thresholdsStyle": {
       "mode": "off"
      },
      "stacking": {
       "mode": "none"
      }
     }
    },
    "overrides": [
     {
      "matcher": {
       "id": "byName",
       "options": "dev-03/temp_c"
      },
      "properties": [
       {
        "id": "displayName",
        "value": "T. exterior hoy (DEV-03 Azure)"
       },
       {
        "id": "color",
        "value": {
         "mode": "fixed",
         "fixedColor": "#E8743B"
        }
       }
      ]
     },
     {
      "matcher": {
       "id": "byName",
       "options": "dev-09/temp_ref_c"
      },
      "properties": [
       {
        "id": "displayName",
        "value": "T. hace un año (DEV-09 dataset)"
       },
       {
        "id": "color",
        "value": {
         "mode": "fixed",
         "fixedColor": "#8B8D98"
        }
       },
       {
        "id": "custom.lineStyle",
        "value": {
         "fill": "dash",
         "dash": [
          10,
          6
         ]
        }
       }
      ]
     },
     {
      "matcher": {
       "id": "byName",
       "options": "dev-03/hr_pct"
      },
      "properties": [
       {
        "id": "displayName",
        "value": "HR hoy (DEV-03)"
       },
       {
        "id": "color",
        "value": {
         "mode": "fixed",
         "fixedColor": "#4FA3D1"
        }
       },
       {
        "id": "unit",
        "value": "percent"
       },
       {
        "id": "custom.axisPlacement",
        "value": "right"
       }
      ]
     }
    ]
   },
   "options": {
    "legend": {
     "displayMode": "table",
     "placement": "bottom",
     "showLegend": true,
     "calcs": [
      "mean",
      "max",
      "min",
      "lastNotNull"
     ]
    },
    "tooltip": {
     "mode": "multi",
     "sort": "none"
    }
   },
