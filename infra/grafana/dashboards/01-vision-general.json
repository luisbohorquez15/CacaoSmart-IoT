  {
   "type": "stat",
   "title": "Dispositivos en línea",
   "targets": [
    {
     "refId": "A",
     "query": "from(bucket: \"cacaosmart\")\n  |> range(start: -30d)   // estado ACTUAL: no depende del selector de tiempo\n  |> filter(fn: (r) => r._measurement == \"status\" and r._field == \"online\")\n  |> group(columns: [\"device\"])\n  |> last()\n  |> group()\n  |> keep(columns: [\"device\", \"_value\"])\n  |> pivot(rowKey: [], columnKey: [\"device\"], valueColumn: \"_value\")"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "mappings": [
      {
       "type": "value",
       "options": {
        "0": {
         "text": "OFFLINE",
         "color": "#E5484D"
        },
        "1": {
         "text": "ONLINE",
         "color": "#46A758"
        }
       }
      }
     ],
     "color": {
      "mode": "thresholds"
     },
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "#E5484D",
        "value": null
       },
       {
        "color": "#46A758",
        "value": 1
       }
      ]
     }
    },
    "overrides": []
   },
   "options": {
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ],
     "fields": "",
     "values": false
    },
