  {
   "type": "table",
   "title": "📊 Promedio · Máximo · Mínimo por variable",
   "description": "",
   "targets": [
    {
     "refId": "A",
     "query": "d = from(bucket: \"cacaosmart\")\n  |> range(start: v.timeRangeStart, stop: v.timeRangeStop)\n  |> filter(fn: (r) => r._measurement == \"telemetry\")\n  |> filter(fn: (r) => (r.device == \"dev-01\" and r._field == \"temp_c\") or\n      (r.device == \"dev-01\" and r._field == \"hr_pct\") or\n      (r.device == \"dev-01\" and r._field == \"luz_lux\") or\n      (r.device == \"dev-02\" and r._field == \"humedad_suelo_pct\") or\n      (r.device == \"dev-02\" and r._field == \"bateria_v\") or\n      (r.device == \"dev-03\" and r._field == \"temp_c\") or\n      (r.device == \"dev-03\" and r._field == \"hr_pct\") or\n      (r.device == \"dev-03\" and r._field == \"uv_index\") or\n      (r.device == \"dev-03\" and r._field == \"viento_kmh\") or\n      (r.device == \"dev-04\" and r._field == \"prob_lluvia_pct\") or\n      (r.device == \"dev-04\" and r._field == \"nubosidad_pct\") or\n      (r.device == \"dev-05\" and r._field == \"cierre_pct\") or\n      (r.device == \"dev-05\" and r._field == \"rad_filtrada_wm2\") or\n      (r.device == \"dev-06\" and r._field == \"caudal_lpm\") or\n      (r.device == \"dev-06\" and r._field == \"presion_psi\") or\n      (r.device == \"dev-07\" and r._field == \"temp_masa_c\") or\n      (r.device == \"dev-07\" and r._field == \"ph_mucilago\") or\n      (r.device == \"dev-08\" and r._field == \"humedad_grano_pct\") or\n      (r.device == \"dev-08\" and r._field == \"temp_interna_c\") or\n      (r.device == \"dev-09\" and r._field == \"temp_ref_c\") or\n      (r.device == \"dev-09\" and r._field == \"et0_dia_mm\") or\n      (r.device == \"dev-10\" and r._field == \"humedad_objetivo_pct\") or\n      (r.device == \"dev-10\" and r._field == \"indice_calidad\"))\n  |> group(columns: [\"device\", \"_field\"])\na = d |> mean() |> set(key: \"stat\", value: \"Promedio\")\nb = d |> max() |> drop(columns: [\"_time\"]) |> set(key: \"stat\", value: \"Máximo\")\nc = d |> min() |> drop(columns: [\"_time\"]) |> set(key: \"stat\", value: \"Mínimo\")\nn = d |> count() |> map(fn: (r) => ({r with _value: float(v: r._value)})) |> set(key: \"stat\", value: \"Muestras\")\nunion(tables: [a, b, c, n])\n  |> keep(columns: [\"device\", \"_field\", \"stat\", \"_value\"])\n  |> group()\n  |> pivot(rowKey: [\"device\", \"_field\"], columnKey: [\"stat\"], valueColumn: \"_value\")\n  |> sort(columns: [\"device\", \"_field\"])"
    }
   ],
   "fieldConfig": {
    "defaults": {
