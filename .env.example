# ============================================================
#  CacaoSmart IoT - variables de entorno (copiar a .env)
#  NUNCA subir el archivo .env a GitHub
# ============================================================

# URL pública: local = http://localhost  ·  Azure = https://<etiqueta>.<region>.cloudapp.azure.com
PUBLIC_URL=http://localhost
ACME_EMAIL=admin@example.com

# Ubicación de la finca (San Vicente de Chucurí, Santander - capital cacaotera de Colombia)
FARM_LAT=6.8817
FARM_LON=-73.4103
TZ=America/Bogota

# Azure Maps Weather (clave entregada en el curso)
AZURE_MAPS_KEY=pon-aqui-tu-llave

# ---------- MQTT (Mosquitto) ----------
MQTT_HOST=mosquitto
MQTT_PORT=1883
# Usuario de dispositivos (ESP32, gemelos, datasets)
MQTT_DEVICE_USER=device
MQTT_DEVICE_PASS=cambia-esto-device
# Servicios internos (Telegraf, Node-RED)
MQTT_SERVICE_USER=service
MQTT_SERVICE_PASS=cambia-esto-service
# Panel web: lectura pública
MQTT_VIEWER_USER=viewer
MQTT_VIEWER_PASS=viewer
# Panel web: operador (puede enviar comandos de retroceso)
MQTT_OPERATOR_USER=operador
MQTT_OPERATOR_PASS=cambia-esto-operador

# ---------- InfluxDB ----------
INFLUX_ORG=cacaosmart
INFLUX_BUCKET=cacaosmart
INFLUX_ADMIN_USER=admin
INFLUX_ADMIN_PASS=cambia-esto-influx
INFLUX_TOKEN=cambia-esto-token-largo-aleatorio
INFLUX_RETENTION=30d

# ---------- Grafana ----------
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASS=cambia-esto-grafana

# ---------- Node-RED ----------
# API REST de comandos: Authorization: Bearer <API_TOKEN>
API_TOKEN=cambia-esto-api-token
# Clave del editor de Node-RED (se convierte a bcrypt al arrancar)
NODERED_ADMIN_USER=admin
NODERED_ADMIN_PASS=cambia-esto-nodered

# ---------- Notificaciones (opcional) ----------
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ---------- Análisis con IA (opcional, para el informe) ----------
ANTHROPIC_API_KEY=
